{
	"name": "@phillipivan/emberplus-connection",
	"version": "0.4.5",
	"description": "Typescript implementation of the Ember+ automation protocol",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist/**/*"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"postinstall": "husky",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"lint-fix": "run lint --fix",
		"unit": "vitest run --coverage",
		"test": "run lint && vitest run",
		"test:coverage": "run test -- --coverage",
		"changelog": "sofie-version",
		"release": "run test && sofie-version",
		"reset": "git clean -dfx && git reset --hard && yarn",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"license-validate": "sofie-licensecheck"
	},
	"contributors": [
		"Gilles Dufour <dufour.gilles@gmail.com> (www.gdnet.be)",
		"Brian Mayton <bmayton@bdm.cc> (http://bdm.cc)",
		"Ola Christian Gundelsby <ola.christian.gundelsby@nrk.no> (https://nrk.no)",
		"Balte de Wit <contact@balte.nl> (https://superfly.tv/)",
		"Richard Cartwright (https://superfly.tv/)",
		"Phillip Ivan Pietruschka (https://github.com/phillipivan)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phillipivan/sofie-emberplus-connection.git"
	},
	"license": "MIT",
	"dependencies": {
		"debug": "^4.4.3",
		"eventemitter3": "^5.0.4",
		"smart-buffer": "^4.2.0"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "~4.7.1",
		"@sofie-automation/code-standard-preset": "~4.0.3",
		"@types/debug": "^4.1.13",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.2.6",
		"vitest": "^5.1.0"
	},
	"bugs": {
		"url": "https://github.com/phillipivan/sofie-emberplus-connection/issues"
	},
	"homepage": "https://github.com/phillipivan/sofie-emberplus-connection#readme",
	"keywords": [
		"emberplus",
		"lawo"
	],
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"yarn prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
