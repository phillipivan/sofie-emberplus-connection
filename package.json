{
	"name": "@phillipivan/emberplus-connection",
	"version": "0.4.5",
	"description": "Typescript implementation of the Ember+ automation protocol",
	"engines": {
		"node": ">=26.13"
	},
	"files": [
		"dist/**/*"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"prepare": "husky",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"lint-fix": "run lint --fix",
		"unit": "jest --coverage",
		"test": "run lint && jest test",
		"test:coverage": "run test -- --coverage",
		"cov": "jest --coverage; open-cli coverage/lcov-report/index.html",
		"cov-open": "open-cli coverage/lcov-report/index.html",
		"changelog": "sofie-version",
		"release": "run reset && run test && sofie-version",
		"reset": "git clean -dfx && git reset --hard && yarn",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"license-validate": "sofie-licensecheck --allowPackages caniuse-lite@1.0.30001541",
		"husky": "./node_modules/.bin/husky",
		"eslint": "./node_modules/.bin/eslint",
		"prettier": "./node_modules/.bin/prettier",
		"lint-staged": "./node_modules/.bin/lint-staged"
	},
	"contributors": [
		"Gilles Dufour <dufour.gilles@gmail.com> (www.gdnet.be)",
		"Brian Mayton <bmayton@bdm.cc> (http://bdm.cc)",
		"Ola Christian Gundelsby <ola.christian.gundelsby@nrk.no> (https://nrk.no)",
		"Balte de Wit <contact@balte.nl> (https://superfly.tv/)",
		"Richard Cartwright (https://superfly.tv/)",
		"Phillip Ivan Pietruschka (https://github.com/phillipivan)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phillipivan/sofie-emberplus-connection.git"
	},
	"license": "MIT",
	"dependencies": {
		"debug": "^4.4.3",
		"eventemitter3": "^5.0.4",
		"long": "^5.3.2",
		"smart-buffer": "^4.2.0",
		"tslib": "^2.9.1"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "~4.7.1",
		"@sofie-automation/code-standard-preset": "~4.0.3",
		"@types/debug": "^4.1.13",
		"@types/jest": "^30.0.0",
		"@types/long": "^5.0.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-plugin-jest": "^29.17.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.4",
		"ts-jest": "^29.4.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"bugs": {
		"url": "https://github.com/phillipivan/sofie-emberplus-connection.git/issues"
	},
	"homepage": "https://github.com/phillipivan/sofie-emberplus-connection.git#readme",
	"keywords": [
		"emberplus",
		"lawo"
	],
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"yarn prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
